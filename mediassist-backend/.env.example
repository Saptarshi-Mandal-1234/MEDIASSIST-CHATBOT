# Copy this file to .env and fill in your real API key
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional overrides
PORT=3000
GEMINI_MODEL=gemini-3.1-flash-lite

# Local use: leave these blank. On Render set them in the dashboard.
# Render sets NODE_ENV via render.yaml and supplies RENDER_EXTERNAL_URL.
DATABASE_URL=
APP_USERNAME=owner
APP_PASSWORD=
# Set for a custom domain or another host, e.g. https://mediassist.example.com
APP_ORIGIN=
# Disposable hosted demo ONLY. Default is false; persistent hosting needs DATABASE_URL.
ALLOW_EPHEMERAL_STORAGE=false
